<!-- ===================== 3. Pedidos por cliente ===================== -->
<h2>3. Pedidos por cliente</h2>
<div id="pedidosCliente">
    <p>Seleccione un cliente para ver sus pedidos.</p>
</div>

<script>
    const API = 'api/';

    // Carga los clientes en el select del formulario y en la tabla
    function cargarClientes() {
        fetch(API + 'clientes')
            .then(function (r) { return r.json(); })
            .then(function (clientes) {
                var sel = document.getElementById('cedula');
                sel.innerHTML = '<option value="">-- Seleccione --</option>';
                clientes.forEach(function (c) {
                    sel.innerHTML += '<option value="' + c.cedula + '">'
                        + c.apellido + ' ' + c.nombre + '</option>';
                });

                var tbody = document.querySelector('#tablaClientes tbody');
                tbody.innerHTML = '';
                clientes.forEach(function (c) {
                    tbody.innerHTML += '<tr>'
                        + '<td>' + c.cedula + '</td>'
                        + '<td>' + c.apellido + '</td>'
                        + '<td>' + c.nombre + '</td>'
                        + '<td><button type="button" onclick="verPedidos(\'' + c.cedula + '\')">Ver pedidos</button></td>'
                        + '</tr>';
                });
            });
    }

    // Carga los productos en el select del formulario
    function cargarProductos() {
        fetch(API + 'productos')
            .then(function (r) { return r.json(); })
            .then(function (productos) {
                var sel = document.getElementById('id_producto');
                sel.innerHTML = '<option value="">-- Seleccione --</option>';
                productos.forEach(function (p) {
                    sel.innerHTML += '<option value="' + p.id_producto + '">' + p.nombre + '</option>';
                });
            });
    }

    // Busca un cliente por cédula
    function buscarCliente() {
        var cedula = document.getElementById('buscarCedula').value.trim();
        var out = document.getElementById('resultadoBusqueda');
        if (!cedula) {
            out.textContent = 'Ingrese una cédula.';
            return;
        }
        fetch(API + 'clientes/' + encodeURIComponent(cedula))
            .then(function (r) { return r.json(); })
            .then(function (c) {
                if (c.error) {
                    out.textContent = 'Cliente no encontrado.';
                } else {
                    out.textContent = c.cedula + ' - ' + c.apellido + ' ' + c.nombre;
                }
            });
    }

    // Muestra los pedidos de un cliente
    function verPedidos(cedula) {
        fetch(API + 'pedidos/' + encodeURIComponent(cedula))
            .then(function (r) { return r.json(); })
            .then(function (pedidos) {
                var div = document.getElementById('pedidosCliente');
                var html = '<h3>Pedidos de la cédula ' + cedula + '</h3>';
                if (!pedidos.length) {
                    html += '<p>Este cliente no tiene pedidos.</p>';
                } else {
                    html += '<table border="1"><tr><th># Pedido</th><th>Producto</th><th>Cliente</th></tr>';
                    pedidos.forEach(function (p) {
                        html += '<tr>'
                            + '<td>' + p.id_pedido + '</td>'
                            + '<td>' + p.nombreProducto + '</td>'
                            + '<td>' + p.apellidoCliente + ' ' + p.nombreCliente + '</td>'
                            + '</tr>';
                    });
                    html += '</table>';
                }
                div.innerHTML = html;
            });
    }

    // Envío del formulario de pedido
    document.getElementById('formPedido').addEventListener('submit', function (e) {
        e.preventDefault();
        var cedula = document.getElementById('cedula').value;
        var idProducto = document.getElementById('id_producto').value;
        var mensaje = document.getElementById('mensajePedido');

        if (!cedula || !idProducto) {
            mensaje.textContent = 'Seleccione un cliente y un producto.';
            return;
        }

        var body = new URLSearchParams();
        body.append('cedula', cedula);
        body.append('id_producto', idProducto);

        fetch(API + 'pedidos', { method: 'POST', body: body })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                mensaje.textContent = res.mensaje;
                if (res.estado === 'ok') {
                    verPedidos(cedula);
                }
            });
    });

    // Carga inicial
    cargarClientes();
    cargarProductos();
</script>

</body>
</html>
