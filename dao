package DAO;

import Conexion.Conexion;
import Model.Pedido;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

/**
 * Acceso a datos de la tabla pedido.
 */
public class PedidoDAO {

    /**
     * Inserta un pedido (un solo producto por pedido).
     *
     * @return true si se insertó correctamente
     */
    public boolean insertar(String cedula, int idProducto) {
        String sql = "INSERT INTO pedido (cedula, id_producto) VALUES (?, ?)";
        try (Connection con = Conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, cedula);
            ps.setInt(2, idProducto);
            return ps.executeUpdate() > 0;
        } catch (SQLException e) {
            System.err.println("Error insertar pedido: " + e.getMessage());
            return false;
        }
    }

    /**
     * Lista los pedidos de un cliente con su detalle (producto y cliente).
     */
    public List<Pedido> listarPorCliente(String cedula) {
        List<Pedido> lista = new ArrayList<>();
        String sql = "SELECT p.id_pedido, p.cedula, p.id_producto, "
                + "       pr.nombre AS nombre_producto, "
                + "       c.apellido AS apellido_cliente, c.nombre AS nombre_cliente "
                + "FROM pedido p "
                + "JOIN producto pr ON p.id_producto = pr.id_producto "
                + "JOIN cliente  c  ON p.cedula = c.cedula "
                + "WHERE p.cedula = ? "
                + "ORDER BY p.id_pedido";
        try (Connection con = Conexion.getConexion();
             PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, cedula);
            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    Pedido p = new Pedido(
                            rs.getInt("id_pedido"),
                            rs.getString("cedula"),
                            rs.getInt("id_producto"));
                    p.setNombreProducto(rs.getString("nombre_producto"));
                    p.setApellidoCliente(rs.getString("apellido_cliente"));
                    p.setNombreCliente(rs.getString("nombre_cliente"));
                    lista.add(p);
                }
            }
        } catch (SQLException e) {
            System.err.println("Error listar pedidos: " + e.getMessage());
        }
        return lista;
    }
}

