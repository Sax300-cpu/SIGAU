package Controller;

import Model.Cliente;
import Model.Pedido;
import Model.Producto;
import Servicios.ClienteServicio;
import Servicios.PedidoServicio;
import Servicios.ProductoServicio;
import com.google.gson.Gson;
import jakarta.ws.rs.Consumes;
import jakarta.ws.rs.FormParam;
import jakarta.ws.rs.GET;
import jakarta.ws.rs.POST;
import jakarta.ws.rs.Path;
import jakarta.ws.rs.PathParam;
import jakarta.ws.rs.Produces;
import jakarta.ws.rs.core.MediaType;
import jakarta.ws.rs.core.Response;
import java.util.List;
import java.util.Map;

/**
 * API REST de la aplicación.
 * Expone endpoints en /api/clientes, /api/productos y /api/pedidos.
 */
@Path("/")
public class Api {

    private final Gson gson = new Gson();
    private final ClienteServicio clienteServicio = new ClienteServicio();
    private final ProductoServicio productoServicio = new ProductoServicio();
    private final PedidoServicio pedidoServicio = new PedidoServicio();

    // ============ CLIENTES ============

    /** Listar todos los clientes. */
    @GET
    @Path("clientes")
    @Produces(MediaType.APPLICATION_JSON)
    public Response listarClientes() {
        List<Cliente> clientes = clienteServicio.listar();
        return Response.ok(gson.toJson(clientes)).build();
    }

    /** Buscar cliente por cédula. */
    @GET
    @Path("clientes/{cedula}")
    @Produces(MediaType.APPLICATION_JSON)
    public Response buscarCliente(@PathParam("cedula") String cedula) {
        Cliente c = clienteServicio.buscarPorCedula(cedula);
        if (c == null) {
            return Response.status(Response.Status.NOT_FOUND)
                    .type(MediaType.APPLICATION_JSON)
                    .entity("{\"error\":\"Cliente no encontrado\"}")
                    .build();
        }
        return Response.ok(gson.toJson(c)).build();
    }

    // ============ PRODUCTOS ============

    /** Listar productos disponibles (predefinidos). */
    @GET
    @Path("productos")
    @Produces(MediaType.APPLICATION_JSON)
    public Response listarProductos() {
        List<Producto> productos = productoServicio.listar();
        return Response.ok(gson.toJson(productos)).build();
    }

    // ============ PEDIDOS ============

    /** Registrar un pedido (un solo producto por pedido). */
    @POST
    @Path("pedidos")
    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)
    @Produces(MediaType.APPLICATION_JSON)
    public Response registrarPedido(@FormParam("cedula") String cedula,
                                    @FormParam("id_producto") int idProducto) {
        Map<String, String> resultado = pedidoServicio.registrar(cedula, idProducto);
        return Response.ok(gson.toJson(resultado)).build();
    }

    /** Visualizar los pedidos de un cliente con su detalle. */
    @GET
    @Path("pedidos/{cedula}")
    @Produces(MediaType.APPLICATION_JSON)
    public Response pedidosPorCliente(@PathParam("cedula") String cedula) {
        List<Pedido> pedidos = pedidoServicio.listarPorCliente(cedula);
        return Response.ok(gson.toJson(pedidos)).build();
    }
}

