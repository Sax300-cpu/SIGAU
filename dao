package Servicios;

import DAO.ClienteDAO;
import DAO.PedidoDAO;
import DAO.ProductoDAO;
import Model.Pedido;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * Lógica de negocio para pedidos.
 * Valida que el cliente y el producto existan antes de registrar.
 */
public class PedidoServicio {

    private final PedidoDAO pedidoDAO = new PedidoDAO();
    private final ClienteDAO clienteDAO = new ClienteDAO();
    private final ProductoDAO productoDAO = new ProductoDAO();

    /**
     * Registra un pedido (un solo producto por pedido) solo para clientes
     * y productos existentes.
     */
    public Map<String, String> registrar(String cedula, int idProducto) {
        Map<String, String> resultado = new HashMap<>();

        if (cedula == null || cedula.trim().isEmpty()) {
            resultado.put("estado", "error");
            resultado.put("mensaje", "Debe seleccionar un cliente.");
            return resultado;
        }
        if (clienteDAO.buscarPorCedula(cedula) == null) {
            resultado.put("estado", "error");
            resultado.put("mensaje", "El cliente no existe.");
            return resultado;
        }
        if (productoDAO.buscarPorId(idProducto) == null) {
            resultado.put("estado", "error");
            resultado.put("mensaje", "El producto no existe.");
            return resultado;
        }

        if (pedidoDAO.insertar(cedula, idProducto)) {
            resultado.put("estado", "ok");
            resultado.put("mensaje", "Pedido registrado correctamente.");
        } else {
            resultado.put("estado", "error");
            resultado.put("mensaje", "No se pudo registrar el pedido.");
        }
        return resultado;
    }

    public List<Pedido> listarPorCliente(String cedula) {
        return pedidoDAO.listarPorCliente(cedula);
    }
}

