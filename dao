-- =====================================================================
--  Proyecto: pruebaProductos
--  Gestión de clientes y pedidos (productos predefinidos)
--  Ejecutar en MySQL (XAMPP): phpMyAdmin o consola mysql
-- =====================================================================

CREATE DATABASE IF NOT EXISTS bd_pedidos
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE bd_pedidos;

DROP TABLE IF EXISTS pedido;
DROP TABLE IF EXISTS producto;
DROP TABLE IF EXISTS cliente;

-- ---------------------------------------------------------------------
-- Clientes (se cargan directo en la base)
-- ---------------------------------------------------------------------
CREATE TABLE cliente (
    cedula   VARCHAR(20)  NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    nombre   VARCHAR(100) NOT NULL,
    PRIMARY KEY (cedula)
) ENGINE=InnoDB;

-- ---------------------------------------------------------------------
-- Productos predefinidos (quemados en la base)
-- ---------------------------------------------------------------------
CREATE TABLE producto (
    id_producto INT          NOT NULL AUTO_INCREMENT,
    nombre      VARCHAR(100) NOT NULL,
    PRIMARY KEY (id_producto),
    UNIQUE KEY uq_producto_nombre (nombre)
) ENGINE=InnoDB;

-- ---------------------------------------------------------------------
-- Pedidos (un solo producto por pedido)
-- ---------------------------------------------------------------------
CREATE TABLE pedido (
    id_pedido   INT         NOT NULL AUTO_INCREMENT,
    cedula      VARCHAR(20) NOT NULL,
    id_producto INT         NOT NULL,
    PRIMARY KEY (id_pedido),
    CONSTRAINT fk_pedido_cliente  FOREIGN KEY (cedula)      REFERENCES cliente (cedula),
    CONSTRAINT fk_pedido_producto FOREIGN KEY (id_producto) REFERENCES producto (id_producto)
) ENGINE=InnoDB;

